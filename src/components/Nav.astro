---
import { ui, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  /** URL of this page in the other language. */
  otherHref?: string;
}

const { lang } = Astro.props;
const t = ui[lang];
const other = lang === 'es' ? 'en' : 'es';
const otherHref = Astro.props.otherHref ?? (other === 'es' ? '/' : '/en/');
const home = lang === 'es' ? '/' : '/en/';
const onHome = Astro.url.pathname === home;
const anchor = (id: string) => (onHome ? `#${id}` : `${home}#${id}`);
---

<header class="nav">
  <div class="wrap nav-inner">
    <a class="brand" href={home}>
      <span class="mark" aria-hidden="true"></span>
      <span>Matias Navio</span>
    </a>

    <nav aria-label={lang === 'es' ? 'Principal' : 'Main'}>
      <ul class="links">
        <li><a href={anchor('proyectos')}>{t.nav.projects}</a></li>
        <li><a href={anchor('experiencia')}>{t.nav.experience}</a></li>
        <li><a href={anchor('stack')}>{t.nav.stack}</a></li>
      </ul>
    </nav>

    <div class="actions">
      <a class="lang" href={otherHref} hreflang={other} lang={other} aria-label={t.switchLabel}>
        <span class:list={{ on: lang === 'es' }}>ES</span>
        <span class:list={{ on: lang === 'en' }}>EN</span>
      </a>
      <a class="btn btn-outline compact" href="#contacto">{t.nav.contact}</a>
    </div>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 40;
    background: rgb(6 16 41 / 0.72);
    backdrop-filter: blur(14px) saturate(140%);
    -webkit-backdrop-filter: blur(14px) saturate(140%);
    box-shadow: inset 0 -1px 0 var(--color-glass-edge);
  }
  .nav-inner {
    display: flex;
    align-items: center;
    gap: 24px;
    height: 64px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 15px;
    font-weight: 500;
    color: var(--color-pearl-body);
    text-decoration: none;
    white-space: nowrap;
  }
  .mark {
    width: 14px;
    height: 14px;
    border-radius: var(--radius-icon);
    background: var(--gradient-pearl);
    box-shadow: var(--shadow-glow);
  }
  nav {
    flex: 1;
  }
  .links {
    display: flex;
    gap: 4px;
  }
  .links a {
    display: inline-flex;
    align-items: center;
    min-height: 32px;
    padding: 4px 12px;
    font-size: 14px;
    font-weight: 500;
    color: var(--color-pearl-muted);
    text-decoration: none;
    border-radius: var(--radius-buttons);
    transition:
      background-color 160ms var(--ease-out),
      color 160ms var(--ease-out);
  }
  .links a:hover {
    color: var(--color-pure-white);
    background: var(--surface-frost-wash);
  }
  .actions {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .lang {
    display: inline-flex;
    align-items: center;
    gap: 2px;
    height: 34px;
    padding: 3px;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.08em;
    text-decoration: none;
    border-radius: var(--radius-buttons);
    box-shadow: var(--shadow-hairline);
  }
  .lang span {
    display: grid;
    place-items: center;
    height: 100%;
    padding-inline: 10px;
    color: var(--color-pearl-dim);
    border-radius: var(--radius-buttons);
    transition: color 160ms var(--ease-out);
  }
  .lang .on {
    color: var(--color-pure-white);
    background: rgb(170 190 255 / 0.1);
    box-shadow: var(--shadow-badge);
  }
  .lang:hover span:not(.on) {
    color: var(--color-pearl-body);
  }

  @media (max-width: 720px) {
    nav {
      display: none;
    }
    .actions {
      margin-left: auto;
    }
  }
</style>
