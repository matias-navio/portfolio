---
import { ui, type Lang } from '../i18n/ui';
import { projects, projectPath, type Project } from '../data/projects';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const p = ui[lang].projects;
const num = (slug: string) => String(projects.findIndex((x) => x.slug === slug) + 1).padStart(2, '0');

/** Featured projects span the full width; the ones in between flow in a two-column grid. */
type Segment = { type: 'featured'; item: Project; flip: boolean } | { type: 'grid'; items: Project[] };
const segments: Segment[] = [];
let featuredCount = 0;
for (const item of projects) {
  if (item.featured) {
    segments.push({ type: 'featured', item, flip: featuredCount++ % 2 === 1 });
  } else {
    const last = segments.at(-1);
    if (last?.type === 'grid') last.items.push(item);
    else segments.push({ type: 'grid', items: [item] });
  }
}
---

<section id="proyectos" class="wrap section" aria-labelledby="projects-h">
  <header class="section-head">
    <p class="eyebrow">{p.eyebrow}</p>
    <h2 id="projects-h" class="t-heading-lg sheen">{p.heading}</h2>
  </header>

  {
    segments.map((seg) =>
      seg.type === 'featured' ? (
        <article class:list={['featured glass', { flip: seg.flip }]}>
          <div class="featured-copy">
            <p class="t-mono idx">
              <span class="pip" aria-hidden="true" />
              {num(seg.item.slug)} · {seg.item.kind[lang]}
            </p>
            <h3 class="t-heading">{seg.item.title}</h3>
            <p class="featured-body">{seg.item.summary[lang]}</p>
            {seg.item.impact &&
              (seg.item.impact.metric ? (
                <p class="impact">
                  <span class="impact-metric">{seg.item.impact.metric}</span>
                  <span class="impact-label">{seg.item.impact.label[lang]}</span>
                </p>
              ) : (
                <p class="impact text">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
                    <path d="M4 20h16M7 16v-4M12 16V8M17 16v-7" />
                  </svg>
                  <span class="impact-label">{seg.item.impact.label[lang]}</span>
                </p>
              ))}
            <ul class="badges">
              {seg.item.stack.slice(0, 4).map((s) => (
                <li class="badge accent">{s}</li>
              ))}
            </ul>
            <div class="featured-actions">
              <a class="btn btn-ghost" href={projectPath(lang, seg.item.slug)}>
                {p.view}
                <svg class="arrow" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                  <path d="M3 8h10M9 4l4 4-4 4" />
                </svg>
              </a>
              {seg.item.url && (
                <a class="btn btn-outline" href={seg.item.url} target="_blank" rel="noopener">
                  {p.visit}
                  <svg class="arrow" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                    <path d="M5 11 11 5M6 5h5v5" />
                  </svg>
                </a>
              )}
            </div>
          </div>
          {seg.item.images?.[0] && (
            <a class="featured-media" href={projectPath(lang, seg.item.slug)} tabindex="-1" aria-hidden="true">
              <img src={seg.item.images[0].src} width={seg.item.images[0].width} height={seg.item.images[0].height} alt="" loading="lazy" decoding="async" />
            </a>
          )}
        </article>
      ) : (
        <ul class="grid">
          {seg.items.map((item) => (
            <li>
              <a class="card glass" href={projectPath(lang, item.slug)}>
                <p class="t-mono idx">
                  {num(item.slug)} · {item.role[lang]}
                </p>
                <h3 class="t-heading-sm">{item.title}</h3>
                {item.impact?.metric && (
                  <p class="impact-pill">
                    <strong>{item.impact.metric}</strong> {item.impact.label[lang]}
                  </p>
                )}
                <p class="card-body">{item.summary[lang]}</p>
                <div class="card-foot">
                  <ul class="badges">
                    {item.stack.slice(0, 3).map((s) => (
                      <li class="badge quiet">{s}</li>
                    ))}
                  </ul>
                  <span class="card-cta" aria-hidden="true">
                    <svg class="arrow" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
                      <path d="M3 8h10M9 4l4 4-4 4" />
                    </svg>
                  </span>
                </div>
              </a>
            </li>
          ))}
        </ul>
      ),
    )
  }
</section>

<style>
  .section {
    display: grid;
    gap: 48px;
    padding-top: var(--section-gap);
  }

  .featured {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: 48px;
    padding: 40px 0 40px 40px;
    overflow: hidden;
  }
  .featured-copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
  }
  .featured-body {
    max-width: 42ch;
    color: var(--color-pearl-muted);
  }
  .badges {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .featured-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: auto;
    padding-top: 16px;
  }
  .featured-media {
    display: block;
    align-self: center;
    padding: 6px 0 6px 6px;
    background: var(--surface-deep-glass);
    border-radius: 12px 0 0 12px;
    box-shadow: var(--shadow-modal-card);
  }
  .featured-media img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 8px 0 0 8px;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }
  .grid li {
    display: flex;
  }
  .card {
    position: relative;
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 12px;
    padding: var(--card-padding);
    text-decoration: none;
    transition:
      background-color 200ms var(--ease-out),
      box-shadow 200ms var(--ease-out);
  }
  .card:hover {
    background: rgb(170 190 255 / 0.05);
  }
  .card-body {
    max-width: 48ch;
    font-size: 15px;
    color: var(--color-pearl-dim);
  }
  .card-foot {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 16px;
    margin-top: auto;
    padding-top: 12px;
  }
  .card-cta {
    display: grid;
    place-items: center;
    flex: none;
    width: 32px;
    height: 32px;
    border-radius: var(--radius-icon);
    transition:
      background-color 200ms var(--ease-out),
      color 200ms var(--ease-out);
  }
  .card:hover .arrow {
    transform: translateX(2px);
  }

  /* Mint highlight */
  .idx {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--color-ember);
  }
  .pip {
    width: 6px;
    height: 6px;
    border-radius: var(--radius-icon);
    background: var(--color-ember);
    box-shadow: 0 0 10px rgb(255 106 61 / 0.8);
  }
  .featured {
    position: relative;
    isolation: isolate;
    box-shadow:
      var(--shadow-feature-card),
      inset 0 0 0 1px var(--color-ember-edge),
      0 0 48px rgb(255 106 61 / 0.08);
  }
  .featured::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    background:
      radial-gradient(ellipse 55% 70% at 0% 0%, rgb(255 106 61 / 0.12), transparent 70%),
      linear-gradient(90deg, transparent, rgb(255 106 61 / 0.6), transparent) top / 60% 1px no-repeat;
    pointer-events: none;
  }
  .card::before {
    content: '';
    position: absolute;
    inset: 0 auto auto 24px;
    width: 56px;
    height: 1px;
    background: linear-gradient(90deg, var(--color-ember), transparent);
    opacity: 0.7;
    transition: width 300ms var(--ease-out), opacity 300ms var(--ease-out);
  }
  .card:hover::before {
    width: calc(100% - 48px);
    opacity: 1;
  }
  .card:hover {
    box-shadow:
      var(--shadow-feature-card),
      inset 0 0 0 1px var(--color-ember-edge),
      0 0 32px rgb(255 106 61 / 0.07);
  }
  .card-cta {
    color: var(--color-ember);
    box-shadow: inset 0 0 0 1px var(--color-ember-edge);
  }
  .card:hover .card-cta {
    color: var(--color-canvas);
    background: var(--color-ember);
  }

  @media (max-width: 880px) {
    .featured {
      grid-template-columns: 1fr;
      gap: 32px;
      padding: 28px 0 0 24px;
    }
    .featured-copy {
      padding-right: 24px;
    }
    .featured-media {
      padding: 6px 0 0 6px;
      border-radius: 12px 0 0 0;
    }
    .featured-media img {
      border-radius: 8px 0 0 0;
    }
    .grid {
      grid-template-columns: 1fr;
    }
  }
  /* Business impact */
  .impact {
    display: flex;
    align-items: baseline;
    gap: 12px;
    padding: 12px 16px;
    border-radius: 12px;
    background: var(--color-ember-soft);
    box-shadow: inset 0 0 0 1px var(--color-ember-edge);
  }
  .impact-metric {
    font-size: 36px;
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--color-ember);
    font-variant-numeric: tabular-nums;
  }
  .impact-label {
    font-size: 15px;
    color: var(--color-pearl);
  }
  .impact.text {
    align-items: center;
    max-width: 44ch;
  }
  .impact.text svg {
    flex: none;
    width: 24px;
    height: 24px;
    color: var(--color-ember);
  }
  .impact-pill {
    align-self: flex-start;
    padding: 4px 12px;
    border-radius: 999px;
    font-size: 14px;
    color: var(--color-pearl);
    background: var(--color-ember-soft);
    box-shadow: inset 0 0 0 1px var(--color-ember-edge);
  }
  .impact-pill strong {
    font-weight: 600;
    color: var(--color-ember);
  }

  /* Second featured project: media on the left */
  .featured.flip {
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    padding: 40px 40px 40px 0;
  }
  .featured.flip .featured-media {
    order: -1;
    padding: 6px 6px 6px 0;
    border-radius: 0 12px 12px 0;
  }
  .featured.flip .featured-media img {
    border-radius: 0 8px 8px 0;
  }

  @media (max-width: 880px) {
    .featured.flip {
      grid-template-columns: 1fr;
      padding: 28px 24px 0 0;
    }
    .featured.flip .featured-copy {
      padding: 0 0 0 24px;
    }
    .featured.flip .featured-media {
      order: 0;
      padding: 6px 6px 0 0;
      border-radius: 0 12px 0 0;
    }
    .featured.flip .featured-media img {
      border-radius: 0 8px 0 0;
    }
  }
</style>
