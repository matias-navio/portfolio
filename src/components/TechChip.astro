---
/** Stack chip: technology logo (when there is one) + label. */
import { techLogo } from '../data/techLogos';

interface Props {
  label: string;
}
const { label } = Astro.props;
const logo = techLogo(label);
---

<li class="tech">
  {
    logo &&
      ('src' in logo ? (
        <img class:list={{ boost: logo.boost }} src={logo.src} alt="" width="18" height="18" loading="lazy" decoding="async" />
      ) : (
        <svg class:list={{ boost: logo.boost }} viewBox="0 0 24 24" aria-hidden="true" style={`fill: ${logo.color}`}>
          <path d={logo.path} />
        </svg>
      ))
  }
  {label}
</li>

<style>
  .tech {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 12px 6px 10px;
    font-size: 13px;
    font-weight: 500;
    color: var(--color-pearl-body);
    background: var(--surface-frost-wash);
    border-radius: var(--radius-badges);
    box-shadow: var(--shadow-badge);
    transition:
      background-color 160ms var(--ease-out),
      box-shadow 160ms var(--ease-out);
  }
  .tech:hover {
    background: rgb(170 190 255 / 0.12);
    box-shadow: var(--shadow-badge), var(--shadow-hairline-strong);
  }
  img,
  svg {
    display: block;
    flex: none;
    width: 18px;
    height: 18px;
  }
  .boost {
    filter: brightness(1.35) drop-shadow(0 0 1.5px rgb(255 255 255 / 0.35));
  }
</style>
