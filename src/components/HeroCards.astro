---
/**
 * Floating glass cards around the hero headline (Authkit-style fan of product cards),
 * themed as backend artifacts: an HTTP request log, a payment webhook, a deploy, a SQL query.
 * Decorative only — hidden from assistive tech and below 1080px.
 */
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const es = lang === 'es';

const requests = [
  { method: 'POST', path: '/api/orders', status: 201, ms: 42 },
  { method: 'GET', path: '/api/products', status: 200, ms: 8 },
  { method: 'PATCH', path: '/api/stock/318', status: 200, ms: 12 },
  { method: 'POST', path: '/api/invoices', status: 201, ms: 87 },
];
---

<div class="hero-cards" aria-hidden="true">
  <!-- Top left: live request log -->
  <div class="slot s1" style="--depth: 6">
    <div class="card float" style="--rot: -5deg; --dur: 7s; --delay: 0s">
      <div class="card-head">
        <span class="dot live"></span>
        <span class="label">api · {es ? 'en vivo' : 'live'}</span>
      </div>
      <ul class="reqs" data-reqs>
        {
          requests.map((r, i) => (
            <li class:list={['req', { on: i === 0 }]}>
              <span class="method">{r.method}</span>
              <span class="path">{r.path}</span>
              <span class="status">{r.status}</span>
              <span class="ms">{r.ms} ms</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <!-- Top right: payment webhook -->
  <div class="slot s2" style="--depth: 9">
    <div class="card float" style="--rot: 4deg; --dur: 8s; --delay: -2s">
      <div class="card-head">
        <span class="dot"></span>
        <span class="label">webhook · mercadopago</span>
      </div>
      <p class="event">payment.approved</p>
      <div class="kv">
        <span>amount</span><span>$ 48.900</span>
        <span>order</span><span>#1042</span>
      </div>
      <p class="ok">
        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6"><path d="m3.5 8.5 3 3 6-7" /></svg>
        {es ? 'Pedido marcado como pagado' : 'Order marked as paid'}
      </p>
    </div>
  </div>

  <!-- Bottom left: deploy -->
  <div class="slot s3" style="--depth: 10">
    <div class="card float" style="--rot: 3deg; --dur: 9s; --delay: -4s">
      <div class="card-head">
        <span class="lights"><i></i><i></i><i></i></span>
        <span class="label">deploy</span>
      </div>
      <p class="cmd"><span class="prompt">$</span> docker compose up -d</p>
      <p class="line"><span class="check">✓</span> api <span class="dim">healthy</span></p>
      <p class="line"><span class="check">✓</span> postgres <span class="dim">healthy</span></p>
      <p class="line"><span class="caret"></span></p>
    </div>
  </div>

  <!-- Bottom right: SQL -->
  <div class="slot s4" style="--depth: 7">
    <div class="card float" style="--rot: -4deg; --dur: 7.5s; --delay: -1s">
      <div class="card-head">
        <span class="dot"></span>
        <span class="label">postgres · query</span>
      </div>
      <p class="sql">
        <span class="kw">SELECT</span> sku, stock<br />
        <span class="kw">FROM</span> products<br />
        <span class="kw">WHERE</span> stock &lt; 5;
      </p>
      <p class="meta"><span data-rows>12</span> rows · 3 ms</p>
    </div>
  </div>
</div>

<script>
  const root = document.querySelector<HTMLElement>('.hero-cards');
  const hero = document.querySelector<HTMLElement>('.hero');
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (root && hero && !reduce) {
    // Mouse parallax: each slot shifts by its --depth.
    let raf = 0;
    hero.addEventListener('pointermove', (e) => {
      const r = hero.getBoundingClientRect();
      const mx = ((e.clientX - r.left) / r.width) * 2 - 1;
      const my = ((e.clientY - r.top) / r.height) * 2 - 1;
      cancelAnimationFrame(raf);
      raf = requestAnimationFrame(() => {
        root.style.setProperty('--mx', mx.toFixed(3));
        root.style.setProperty('--my', my.toFixed(3));
      });
    });
    hero.addEventListener('pointerleave', () => {
      root.style.setProperty('--mx', '0');
      root.style.setProperty('--my', '0');
    });

    // Request log: highlight a new request every few seconds.
    const reqs = [...root.querySelectorAll<HTMLElement>('[data-reqs] .req')];
    const rows = root.querySelector<HTMLElement>('[data-rows]');
    let i = 0;
    let timer = 0;
    const tick = () => {
      reqs[i]?.classList.remove('on');
      i = (i + 1) % reqs.length;
      reqs[i]?.classList.add('on');
      if (rows) rows.textContent = String(8 + Math.floor(Math.random() * 9));
    };
    new IntersectionObserver(([e]) => {
      clearInterval(timer);
      if (e.isIntersecting) timer = window.setInterval(tick, 2400);
    }).observe(root);
  }
</script>

<style>
  .hero-cards {
    --mx: 0;
    --my: 0;
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .slot {
    position: absolute;
    width: 248px;
    transform: translate3d(calc(var(--mx) * var(--depth) * -1px), calc(var(--my) * var(--depth) * -1px), 0);
    transition: transform 900ms var(--ease-out);
  }
  .s1 {
    top: 24px;
    left: 0;
  }
  .s2 {
    top: 64px;
    right: 0;
  }
  .s3 {
    top: 300px;
    left: 32px;
  }
  .s4 {
    top: 320px;
    right: 24px;
  }

  .card {
    display: grid;
    gap: 10px;
    padding: 16px;
    font-size: 12px;
    text-align: left;
    color: var(--color-pearl-muted);
    background: rgb(6 16 41 / 0.82);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border-radius: var(--radius-cards);
    box-shadow: var(--shadow-modal-card), var(--shadow-hairline);
    opacity: 0;
    animation:
      enter 900ms var(--ease-out) forwards,
      bob var(--dur) ease-in-out var(--delay) infinite;
  }
  .s1 .card {
    animation-delay: 150ms, var(--delay);
  }
  .s2 .card {
    animation-delay: 300ms, var(--delay);
  }
  .s3 .card {
    animation-delay: 450ms, var(--delay);
  }
  .s4 .card {
    animation-delay: 600ms, var(--delay);
  }
  @keyframes enter {
    from {
      opacity: 0;
      translate: 0 16px;
    }
    to {
      opacity: 0.92;
      translate: 0 0;
    }
  }
  @keyframes bob {
    0%,
    100% {
      transform: rotate(var(--rot)) translateY(0);
    }
    50% {
      transform: rotate(calc(var(--rot) * 0.6)) translateY(-8px);
    }
  }

  .card-head {
    display: flex;
    align-items: center;
    gap: 8px;
    padding-bottom: 10px;
    box-shadow: inset 0 -1px 0 var(--color-glass-edge);
  }
  .label {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-pearl-dim);
  }
  .dot {
    width: 6px;
    height: 6px;
    border-radius: var(--radius-icon);
    background: rgb(170 190 255 / 0.4);
  }
  .dot.live {
    background: var(--color-ember);
    box-shadow: 0 0 8px rgb(255 106 61 / 0.8);
    animation: blink 2.4s ease-in-out infinite;
  }
  @keyframes blink {
    50% {
      opacity: 0.35;
    }
  }
  .lights {
    display: flex;
    gap: 4px;
  }
  .lights i {
    width: 7px;
    height: 7px;
    border-radius: var(--radius-icon);
    background: rgb(170 190 255 / 0.18);
  }

  /* Request log */
  .reqs {
    display: grid;
    gap: 4px;
    font-family: var(--font-mono);
    font-size: 11px;
  }
  .req {
    display: grid;
    grid-template-columns: 42px 1fr auto auto;
    gap: 8px;
    align-items: center;
    padding: 4px 6px;
    margin-inline: -6px;
    color: var(--color-pearl-dim);
    border-radius: var(--radius-badges);
    transition:
      background-color 400ms var(--ease-out),
      color 400ms var(--ease-out);
  }
  .req.on {
    color: var(--color-pearl-body);
    background: var(--color-luminous-fill);
  }
  .path {
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }
  .method,
  .status {
    color: var(--color-pearl);
  }
  .ms {
    color: var(--color-pearl-dim);
  }

  /* Webhook */
  .event {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--color-pearl);
  }
  .kv {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 4px 12px;
    font-family: var(--font-mono);
    font-size: 11px;
  }
  .kv span:nth-child(odd) {
    color: var(--color-pearl-dim);
  }
  .kv span:nth-child(even) {
    text-align: right;
    color: var(--color-pearl-body);
  }
  .ok {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 6px 8px;
    font-size: 11.5px;
    font-weight: 500;
    color: var(--color-pearl-body);
    background: var(--surface-frost-wash);
    border-radius: var(--radius-badges);
    box-shadow: var(--shadow-hairline);
  }
  .ok svg {
    width: 13px;
    height: 13px;
    color: var(--color-sapphire-light);
  }

  /* Deploy */
  .cmd,
  .line,
  .sql,
  .meta {
    font-family: var(--font-mono);
    font-size: 11px;
    line-height: 1.6;
  }
  .cmd {
    color: var(--color-pearl-body);
  }
  .prompt,
  .check {
    color: var(--color-sapphire-light);
  }
  .dim {
    color: var(--color-pearl-dim);
  }
  .caret {
    display: inline-block;
    width: 7px;
    height: 13px;
    vertical-align: middle;
    background: var(--color-pearl-body);
    animation: caret 1.1s steps(1) infinite;
  }
  @keyframes caret {
    50% {
      opacity: 0;
    }
  }

  /* SQL */
  .sql {
    color: var(--color-pearl-body);
  }
  .kw {
    color: var(--color-sapphire-light);
  }
  .meta {
    color: var(--color-pearl-dim);
  }

  @media (max-width: 1180px) {
    .slot {
      width: 220px;
    }
    .s1,
    .s3 {
      left: -12px;
    }
    .s2,
    .s4 {
      right: -12px;
    }
  }
  @media (max-width: 1080px) {
    .hero-cards {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .card {
      opacity: 0.92;
      animation: none;
      transform: rotate(var(--rot));
    }
    .slot {
      transition: none;
    }
  }
</style>
