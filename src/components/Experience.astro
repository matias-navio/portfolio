---
import { ui, stack, type Lang, type StackGroup } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];

/** 1.5px line-art glyphs, 24×24. */
const icons: Record<StackGroup, string> = {
  java: 'M5 10h11v4a5 5 0 0 1-5 5h-1a5 5 0 0 1-5-5v-4ZM16 11h1.5a2.5 2.5 0 0 1 0 5H16M9 3c-1 1.2 1 1.8 0 3M12.5 3c-1 1.2 1 1.8 0 3',
  node: 'M12 3l7.8 4.5v9L12 21l-7.8-4.5v-9L12 3ZM10 10l-2 2 2 2M14 10l2 2-2 2',
  front: 'M12 3v4M12 17v4M3 12h4M17 12h4M6.3 6.3l2.5 2.5M15.2 15.2l2.5 2.5M6.3 17.7l2.5-2.5M15.2 8.8l2.5-2.5',
  data: 'M4 6c0-1.7 3.6-3 8-3s8 1.3 8 3-3.6 3-8 3-8-1.3-8-3ZM4 6v12c0 1.7 3.6 3 8 3s8-1.3 8-3V6M4 12c0 1.7 3.6 3 8 3s8-1.3 8-3',
  infra: 'M3 8l9-5 9 5-9 5-9-5ZM3 8v8l9 5 9-5V8M12 13v8',
  integrations: 'M9 7V3M15 7V3M6 7h12v4a6 6 0 0 1-12 0V7ZM12 17v4',
};
---

<section id="experiencia" class="wrap section" aria-labelledby="exp-h">
  <header class="section-head">
    <p class="eyebrow">{t.experience.eyebrow}</p>
    <h2 id="exp-h" class="t-heading-lg sheen">{t.experience.heading}</h2>
  </header>
  <ol class="rows glass">
    {
      t.experience.rows.map((r) => (
        <li class="row">
          <span class="t-mono period">{r.period}</span>
          <div class="who">
            <h3 class="t-heading-sm">{r.role}</h3>
            <p class="org">{r.org}</p>
          </div>
          <p class="desc">{r.body}</p>
        </li>
      ))
    }
  </ol>
</section>

<section id="stack" class="wrap section" aria-labelledby="stack-h">
  <header class="section-head">
    <p class="eyebrow">{t.stack.eyebrow}</p>
    <h2 id="stack-h" class="t-heading-lg sheen">{t.stack.heading}</h2>
  </header>
  <ul class="stack">
    {
      stack.map((g) => (
        <li class="group glass">
          <div class="group-head">
            <span class="tile" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d={icons[g.id]} />
              </svg>
            </span>
            <h3 class="t-heading-sm">{t.stack.groups[g.id]}</h3>
          </div>
          <ul class="badges">
            {g.items.map((s) => (
              <li class:list={['badge', { quiet: !g.strong }]}>{s}</li>
            ))}
          </ul>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .section {
    display: grid;
    gap: 48px;
    padding-top: var(--section-gap);
  }

  .rows {
    padding: 8px var(--card-padding);
  }
  .row {
    display: grid;
    grid-template-columns: 200px minmax(0, 1fr) minmax(0, 1.4fr);
    gap: 24px;
    padding-block: 24px;
  }
  .row + .row {
    border-top: 1px solid var(--color-glass-edge);
  }
  .period {
    padding-top: 5px;
  }
  .who {
    display: grid;
    gap: 4px;
    align-content: start;
  }
  .org {
    font-size: 15px;
    color: var(--color-pearl-muted);
  }
  .desc {
    max-width: 56ch;
    color: var(--color-pearl-dim);
  }

  .stack {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }
  .group {
    display: grid;
    align-content: start;
    gap: 20px;
    padding: var(--card-padding);
  }
  .group-head {
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .tile {
    display: grid;
    place-items: center;
    flex: none;
    width: 48px;
    height: 48px;
    color: var(--color-pearl-body);
    background: var(--surface-frost-wash);
    border-radius: var(--radius-icon);
    box-shadow: var(--shadow-hairline), inset 0 1px 1px rgb(247 243 236 / 0.16);
  }
  .tile svg {
    width: 22px;
    height: 22px;
  }
  .group .t-heading-sm {
    font-size: 17px;
  }
  .badges {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  @media (max-width: 960px) {
    .stack {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 880px) {
    .row {
      grid-template-columns: 1fr;
      gap: 8px;
    }
  }
  @media (max-width: 600px) {
    .stack {
      grid-template-columns: 1fr;
    }
  }
</style>
